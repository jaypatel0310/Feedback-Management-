<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - Feedback Management Module</title>

    <style>
        :root {
            --ink: #1e1b4b;
            --muted: #6b7280;
            --line: #e5e7eb;
            --brand: #6366f1;
            --brand-dark: #4f46e5;
            --accent: #14b8a6;
            --star: #f59e0b;
            --danger: #e11d48;
            --bg: #f5f3ff;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family: "Segoe UI", system-ui, -apple-system, Roboto, Arial, sans-serif;
            color: var(--ink);
            background: radial-gradient(circle at 10% 0%, #e0e7ff 0, transparent 40%), radial-gradient(circle at 100% 100%, #ccfbf1 0, transparent 40%), var(--bg);
        }

        /* ---------- Top bar ---------- */
        .topbar {
            background: linear-gradient(120deg, #4338ca 0%, #6366f1 55%, #14b8a6 130%);
            color: #fff;
            padding: 34px 20px 70px;
            text-align: center;
        }

            .topbar .badge {
                display: inline-block;
                padding: 4px 14px;
                margin-bottom: 12px;
                font-size: 12px;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                background: rgba(255,255,255,.18);
                border: 1px solid rgba(255,255,255,.35);
                border-radius: 999px;
            }

            .topbar h1 {
                margin: 0;
                font-size: 32px;
                font-weight: 700;
                letter-spacing: .3px;
            }

            .topbar p {
                margin: 8px 0 0;
                opacity: .85;
                font-size: 15px;
            }

        /* ---------- Page card ---------- */
        .page {
            flex: 1;
            width: 100%;
            max-width: 640px;
            margin: -48px auto 40px;
            padding: 0 16px;
        }

        .card {
            background: #fff;
            border-radius: 18px;
            padding: 34px 36px;
            box-shadow: 0 20px 45px -15px rgba(67, 56, 202, .35);
        }

            .card h2 {
                margin: 0 0 4px;
                font-size: 24px;
            }

            .card .sub {
                margin: 0 0 26px;
                color: var(--muted);
                font-size: 14px;
            }

        /* ---------- Form ---------- */
        .form-group {
            margin-bottom: 20px;
        }

            .form-group label,
            .form-group .label {
                display: block;
                margin-bottom: 7px;
                font-size: 13px;
                font-weight: 600;
                letter-spacing: .3px;
                color: #374151;
            }

        .form-control {
            width: 100%;
            padding: 12px 14px;
            font: inherit;
            font-size: 15px;
            color: var(--ink);
            background: #f9fafb;
            border: 1.5px solid var(--line);
            border-radius: 10px;
            transition: border-color .15s, box-shadow .15s, background .15s;
        }

            .form-control::placeholder {
                color: #9ca3af;
            }

            .form-control:focus {
                outline: none;
                background: #fff;
                border-color: var(--brand);
                box-shadow: 0 0 0 4px rgba(99, 102, 241, .15);
            }

        textarea.form-control {
            min-height: 120px;
            resize: vertical;
        }

        .field-validation-error {
            display: block;
            margin-top: 6px;
            font-size: 13px;
            color: var(--danger);
        }

        .input-validation-error {
            border-color: var(--danger);
            background: #fff1f2;
        }

        /* Star rating (pure CSS, posts the same "Rating" value) */
        .star-rating {
            display: inline-flex;
            flex-direction: row-reverse;
            gap: 4px;
        }

            .star-rating input {
                position: absolute;
                opacity: 0;
                pointer-events: none;
            }

            .star-rating label {
                margin: 0;
                font-size: 34px;
                line-height: 1;
                color: #d1d5db;
                cursor: pointer;
                transition: color .12s, transform .12s;
            }

                .star-rating label:hover,
                .star-rating label:hover ~ label,
                .star-rating input:checked ~ label {
                    color: var(--star);
                }

                .star-rating label:hover {
                    transform: scale(1.15);
                }

            .star-rating input:focus-visible + label {
                outline: 2px solid var(--brand);
                border-radius: 4px;
            }

        /* ---------- Buttons ---------- */
        .btn {
            display: inline-block;
            width: 100%;
            padding: 14px;
            font: inherit;
            font-size: 16px;
            font-weight: 600;
            text-align: center;
            text-decoration: none;
            color: #fff;
            background: linear-gradient(120deg, var(--brand-dark), var(--brand));
            border: 0;
            border-radius: 10px;
            cursor: pointer;
            box-shadow: 0 8px 18px -6px rgba(79, 70, 229, .6);
            transition: transform .12s, box-shadow .12s;
        }

            .btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 12px 22px -6px rgba(79, 70, 229, .7);
            }

        .btn-outline {
            color: var(--brand-dark);
            background: #fff;
            border: 1.5px solid var(--brand);
            box-shadow: none;
        }

            .btn-outline:hover {
                background: #eef2ff;
                box-shadow: none;
            }

        /* ---------- Details page ---------- */
        .success {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            margin-bottom: 26px;
            font-size: 14px;
            font-weight: 600;
            color: #0f766e;
            background: #ccfbf1;
            border-radius: 10px;
        }

            .success .tick {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 24px;
                height: 24px;
                color: #fff;
                background: var(--accent);
                border-radius: 50%;
            }

        .person {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 24px;
        }

        .avatar {
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 60px;
            width: 60px;
            height: 60px;
            font-size: 26px;
            font-weight: 700;
            color: #fff;
            background: linear-gradient(135deg, var(--brand), var(--accent));
            border-radius: 50%;
        }

        .person h3 {
            margin: 0;
            font-size: 20px;
        }

        .person span {
            color: var(--muted);
            font-size: 14px;
            word-break: break-all;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            margin-bottom: 14px;
        }

        .info-box {
            padding: 14px 16px;
            background: #f9fafb;
            border: 1px solid var(--line);
            border-radius: 12px;
        }

            .info-box.full {
                grid-column: 1 / -1;
            }

            .info-box .k {
                margin-bottom: 4px;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 1.2px;
                text-transform: uppercase;
                color: var(--muted);
            }

            .info-box .v {
                font-size: 16px;
                font-weight: 600;
                word-wrap: break-word;
            }

                .info-box .v.comment {
                    font-weight: 400;
                    line-height: 1.6;
                    white-space: pre-line;
                }

        .stars-static {
            font-size: 22px;
            letter-spacing: 2px;
            color: #d1d5db;
        }

            .stars-static .on {
                color: var(--star);
            }

            .stars-static small {
                margin-left: 6px;
                font-size: 14px;
                letter-spacing: 0;
                color: var(--muted);
            }

        .actions {
            margin-top: 26px;
        }

        /* ---------- Footer ---------- */
        .footer {
            padding: 20px;
            text-align: center;
            font-size: 14px;
            color: #c7d2fe;
            background: #1e1b4b;
        }

            .footer strong {
                color: #fff;
                font-weight: 600;
            }

        @@media (max-width: 520px) {
            .card {
                padding: 26px 20px;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }

            .topbar h1 {
                font-size: 25px;
            }
        }
    </style>
</head>

<body>

    <header class="topbar">
        <span class="badge">Student Portal</span>
        <h1>Feedback Management Module</h1>
        <p>Your voice helps us improve every course.</p>
    </header>

    <main class="page">
        <div class="card">
            @RenderBody()
        </div>
    </main>

    <footer class="footer">
        <strong>Department CE</strong> &middot; Marwadi University
    </footer>

</body>
</html>