@model Practical7.Models.Feedback

@{
    ViewBag.Title = "Student Feedback";
    Layout = "~/Views/Shared/_FeedbackS1Page1.cshtml";
}

<h2>Share your feedback</h2>
<p class="sub">Fill in the form below. All fields are required.</p>

@using (Html.BeginForm(null, null, FormMethod.Post, new { novalidate = "novalidate" }))
{
    <div class="form-group">
        @Html.LabelFor(m => m.StudentName, "Full Name")
        @Html.TextBoxFor(m => m.StudentName, new { @class = "form-control", placeholder = "e.g. Riya Patel" })
        @Html.ValidationMessageFor(m => m.StudentName)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.StudentEmail, "Email Address")
        @Html.TextBoxFor(m => m.StudentEmail, new { @class = "form-control", type = "email", placeholder = "you@example.com" })
        @Html.ValidationMessageFor(m => m.StudentEmail)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Course, "Course")
        @Html.TextBoxFor(m => m.Course, new { @class = "form-control", placeholder = "e.g. ASP.NET MVC" })
        @Html.ValidationMessageFor(m => m.Course)
    </div>

    <div class="form-group">
        <span class="label">Rating</span>
        <div class="star-rating">
            @for (int i = 5; i >= 1; i--)
            {
                @Html.RadioButtonFor(m => m.Rating, i, new { id = "star" + i })
                <label for="star@(i)" title="@i out of 5">&#9733;</label>
            }
        </div>
        @Html.ValidationMessageFor(m => m.Rating)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Comment, "Comment")
        @Html.TextAreaFor(m => m.Comment, new { @class = "form-control", placeholder = "Tell us what you liked and what could be better..." })
        @Html.ValidationMessageFor(m => m.Comment)
    </div>

    <input type="submit" value="Submit Feedback" class="btn" />
}